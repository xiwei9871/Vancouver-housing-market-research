<!DOCTYPE html><html lang="en"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
  
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <meta name="theme-color" content="#ffffff">
  <link id="favicon" rel="shortcut icon" href="https://static.realtor.ca/images/common/icons/browser/favicon.ico?v=3" type="image/x-icon">
  
  <title>Sorry, you have been blocked / Désolé, vous avez été bloqué | REALTOR.ca</title>

  <style>
    :root {
      --realtor-red: #D0191D;
      --text-primary: #252525;
      --text-secondary: #626262;
      --border: #e2e2e2;
      --background: #f7f7f7;
      --card-background: #ffffff;
    }

    * {
      box-sizing: border-box;
    }

    html,
    body {
      min-height: 100%;
      margin: 0;
    }

    body {
      display: flex;
      justify-content: flex-start;
      align-items: center;
      flex-direction: column;
      min-height: 100vh;
      padding: clamp(48px, 10vh, 120px) 24px 40px;
      background: var(--background);
      color: var(--text-primary);
      font-family:
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Roboto,
        Helvetica,
        Arial,
        sans-serif;
      line-height: 1.5;
    }

    .challenge-card {
      width: min(90%, 1140px);
      padding: clamp(24px, 5vw, 40px);
      background: var(--card-background);
      border: 1px solid var(--border);
      border-radius: 12px;
      box-shadow: 0 8px 28px rgba(0, 0, 0, 0.06);
      text-align: center;
	  box-sizing: border-box;
    }

    .logo {
      display: block;
      width: 180px;
      max-width: 65%;
      height: auto;
      margin: 0 auto 32px;
    }

    h1 {
      margin: 0 0 12px;
      font-size: clamp(1.5rem, 4vw, 2rem);
      line-height: 1.2;
    }

    p {
      margin: 0;
      color: var(--text-secondary);
      font-size: 1rem;
    }

    .challenge-container {
      margin: 28px 0 20px;
    }    

    .help {
      margin-top: 20px;
      font-size: 0.875rem;
    }

    .divider {
      width: 100%;
      height: 2px;
      margin: 32px 0 20px;
      border: 0;
      background: var(--realtor-red);
    }

    .ray-id {
      margin: 0;
      color: #858585;
      font-size: 0.75rem;
      overflow-wrap: anywhere;
    }
  

    @media (max-width: 600px) {
      body {
        padding: 20px 16px 24px;
      }

      .challenge-card {
        width: 90%;
        padding: 24px;
        border-radius: 10px;
      }

      .logo {
        width: 150px;
        margin-bottom: 24px;
      }

      h1 {
        font-size: 1.6rem;
      }

      p {
        font-size: 0.95rem;
      }

      .loading {
        align-items: flex-start;
        text-align: left;
      }
    }

    @media (max-width: 360px) {
      body {
        padding-right: 12px;
        padding-left: 12px;
      }

      .challenge-card {
        padding: 22px 18px;
      }
    }

   
	
	.hide {
		display: none;
	}
	.footer-separator{ margin: 0 2px; }
	.columns{ display: flex;
    text-align: LEFT;}
	.column{flex-basis: 50%;
    padding: 0 10px;}
  </style>
</head>

<body>
